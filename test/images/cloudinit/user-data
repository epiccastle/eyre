#cloud-config

# Set root password. on bsd ran:
# encrypt -b 8 'testpassword'
users:
  - name: testuser
    #passwd: $2b$08$gd1HRsIU71nNPw9BBjqv7.SNphlUeHG9fXuZIP.gyIUke2F4rL35y
    plain_text_passwd: 'root-access-please'
    groups: wheel
    lock_passwd: false
    ssh_authorized_keys:
      - ssh-rsa  crispin@knives
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
      - ssh-rsa  crispin@knives

disable_root: false

# Allow root SSH password login (optional)
ssh_pwauth: true

# runcmd only ever runs once, the first time its booted
runcmd:
  - cat /etc/ssh/sshd_config | grep -v PermitRootLogin > /etc/ssh/sshd_config.new
  - echo "PermitRootLogin yes" >> /etc/ssh/sshd_config.new
  - mv /etc/ssh/sshd_config.new /etc/ssh/sshd_config
  - rcctl reload sshd

  - echo 'testuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

  - echo 'root:$2a$10$j9vfYzP.RXS/jjSI8ELSOeNubpW8DvCyC5kW77O8R7LqUv9Ota4HS:0:0:daemon:0:0:Root User:/root:/bin/ksh' > /root/master.passwd
  - grep -v "^root:" /etc/master.passwd >> /root/master.passwd
  - mv /root/master.passwd /etc/master.passwd
  - pwd_mkdb -p /etc/master.passwd
