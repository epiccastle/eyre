{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {:run
  {:main-opts ["-m" "eyre"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                babashka/process {:mvn/version "0.6.25"}
                io.epiccastle/clojuressh {:mvn/version "1.0.0"}
                medley/medley {:mvn/version "1.4.0"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          slipset/deps-deploy {:mvn/version "0.2.2"}}
   :ns-default build}

  :codox {:extra-deps {codox/codox {:mvn/version "0.10.8"}
                       babashka/fs {:mvn/version "0.1.11"}
                       io.epiccastle/codox-theme-epiccastle {:mvn/version "0.1.0-SNAPSHOT"}}
          :exec-fn codox.main/generate-docs
          :exec-args {:source-paths ["src"]
                      :metadata {:doc/format :markdown}
                      :output-path "target/docs"
                      :doc-paths ["docs"]
                      :themes [:epiccastle]
                      :name "eyre"
                      :description "Probe an operating system and user environment for facts"
                      :license {:name "Eclipse Public License 2.0"
                                :url "https://github.com/epiccastle/eyre/blob/main/LICENSE"}}}}

 :lib io.epiccastle/eyre
 :description "Probe an operating system and user environment for facts"}
